docker.enabled = true
docker.runOptions = '--cpus 0.000 -u root --entrypoint ""'

params.contPfx = ''

process {
    executor = 'awsbatch'
    // withName: 'segmentation:worker' {
    //     queue = 'gpu'
    //     clusterOptions = '--gres=gpu:1'
    // }
    withName:illumination   {
        time   = '6h'
        memory = '64G'
    }
    withName:coreograph     {
        time   = '12h'
        memory = '128G'
    }
    withName:ashlar         {
        time   = '12h'
        memory = '64G'
    }
    withName:s3seg          {
        time   = '1h'
        memory = '4G'
    }
    withName:mcquant        {
        time   = '1h'
        memory = '16G'
    }
    withName:worker         {
        cpus   = 4
        time   = '1h'
        memory = '32G'
    }
}
aws {
    // region = 'us-east-1'
    // batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
}

